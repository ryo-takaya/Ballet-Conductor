# このファイルを .env にコピーして使う（.env は Git に入れない）
#   cp .env.example .env

# Stripe（テストモードのキーだけを使う。sk_live_ で始まる本番のキーは入れない）
# https://dashboard.stripe.com/test/apikeys の「シークレットキー」（sk_test_...）
STRIPE_SECRET_KEY=
# Webhook の署名シークレット（whsec_...）。ローカルでは stripe-cli の `listen --print-secret` で表示される値
STRIPE_WEBHOOK_SECRET=

# CD 1 枚の料金（円、税込・送料込）。省略すると 3000
# CD_PRICE_JPY=3000
